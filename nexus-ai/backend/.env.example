# ==============================================================================
# NEXUSAI BACKEND (SUPABASE & RENDER) ENVIRONMENT TEMPLATE
# Copy to .env and fill in with your real Supabase & Render details
# ==============================================================================

# 1. Supabase Project Credentials (Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. Supabase Database Connection Strings (Dashboard -> Settings -> Database)
# Transaction pooler (port 6543) is ideal for Render web services
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# 3. Render Hosting Settings
RENDER_SERVICE_ID=srv-your-render-service-id
RENDER_EXTERNAL_URL=https://nexusai-backend.onrender.com
PORT=5000
NODE_ENV=production

